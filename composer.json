{
    "name": "otp-com/sdk-php",
    "description": "PHP client for the otp.com OTP API: send, verify, and resend one-time passwords.",
    "keywords": [
        "otp",
        "2fa",
        "one-time-password",
        "verification",
        "sdk",
        "api-client"
    ],
    "homepage": "https://github.com/otp-com/sdk-php",
    "license": "MIT",
    "authors": [
        {
            "name": "otp.com",
            "homepage": "https://otp.com"
        }
    ],
    "support": {
        "issues": "https://github.com/otp-com/sdk-php/issues",
        "source": "https://github.com/otp-com/sdk-php"
    },
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.3",
        "guzzlehttp/psr7": "^1.7 || ^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^8.0 || ^9.0",
        "friendsofphp/php-cs-fixer": "^3.5"
    },
    "autoload": {
        "psr-4": { "OtpCom\\Sdk\\" : "lib/" }
    },
    "autoload-dev": {
        "psr-4": { "OtpCom\\Sdk\\Test\\" : "test/" }
    },
    "scripts": {
        "test": "phpunit"
    }
}
